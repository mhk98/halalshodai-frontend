# Backend REST API base URL used by the browser (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.halalshodai.xyz/api/v1
# Optional: API URL for server-side rendering (e.g. internal Docker hostname). Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://halalshodai.xyz
NEXT_PUBLIC_SITE_NAME="[YOUR_BRAND]"

# Origins allowed for next/image (comma-separated). Add your API / CDN / S3 public URL in production.
NEXT_IMAGE_ORIGINS=https://placehold.co,https://api.halalshodai.xyz,https://res.cloudinary.com

# Tracking — used only if not set in admin → Settings → Tracking
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Floating chat buttons — used only if not set in admin → Settings → Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
NEXT_PUBLIC_MESSENGER_URL=https://m.me/your.page

# Shared secret for POST /api/revalidate (called by the backend after admin changes).
# Must match the backend's REVALIDATE_SECRET. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# Server-only. Same value as the backend's INTERNAL_API_KEY: server-rendered pages call the API
# from one IP for all visitors, and this key exempts them from the per-IP rate limit.
INTERNAL_API_KEY=

# Set to "standalone" to build a minimal server bundle for Docker
NEXT_OUTPUT=
